# Copy to .env and fill in your values
DATABASE_URL=postgresql://parentpilot:parentpilot@localhost:5432/parentpilot
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production

# Dev mode: set to False in production; uses DEV_OTP instead of real SMS
DEV_MODE=True
DEV_OTP=123456

# Twilio (OTP SMS) — required when DEV_MODE=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase (push notifications) — required in Phase 4+
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# TURN server (WebRTC) — required in Phase 2+
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=
